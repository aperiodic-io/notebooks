{%- extends 'lab/index.html.j2' -%}

{%- block header -%}
{{ super() }}
<style>
  /* ── Aperiodic branding overrides ────────────────────────────── */

  :root {
    --ap-bg: #faf8f5;
    --ap-bg-muted: #f3efe9;
    --ap-bg-alt: #f8f5f0;
    --ap-border: #ece6dd;
    --ap-text: #4a463e;
    --ap-text-heading: #14110b;
    --scrollbar-thumb: #ddd8d0;
  }

  html.dark {
    --ap-bg: #0f0d08;
    --ap-bg-muted: #1a1710;
    --ap-bg-alt: #1f1b13;
    --ap-border: #252015;
    --ap-text: #c8c0b4;
    --ap-text-heading: #e8e0d0;
    --scrollbar-thumb: #3a3328;

    /* Override JupyterLab theme variables for dark mode */
    --jp-layout-color0: #0f0d08;
    --jp-layout-color1: #0f0d08;
    --jp-layout-color2: #1a1710;
    --jp-layout-color3: #2a2418;
    --jp-layout-color4: #3a3328;
    --jp-ui-font-color0: rgba(232, 226, 216, 1);
    --jp-ui-font-color1: rgba(200, 192, 180, 0.87);
    --jp-ui-font-color2: rgba(200, 192, 180, 0.6);
    --jp-content-font-color0: rgba(232, 226, 216, 1);
    --jp-content-font-color1: rgba(200, 192, 180, 0.87);
    --jp-content-font-color2: rgba(200, 192, 180, 0.6);
    --jp-content-font-color3: rgba(200, 192, 180, 0.4);
    --jp-cell-editor-background: #1a1710;
    --jp-cell-editor-border-color: #2a2418;
    --jp-cell-editor-active-background: #0f0d08;
    --jp-cell-prompt-not-active-font-color: #6b6358;
    --jp-cell-inprompt-font-color: #5a9fd4;
    --jp-cell-outprompt-font-color: #d4845a;
    --md-grey-100: #1a1710;
    --md-grey-200: #1f1b13;
    --md-grey-300: #2a2418;
    --md-grey-400: #3a3328;
    --md-grey-700: #8a8278;
    --md-grey-900: #c8c0b4;

    /* Syntax highlighting — light-on-dark palette */
    --jp-mirror-editor-keyword-color: #72b866;
    --jp-mirror-editor-atom-color: #a8a0ff;
    --jp-mirror-editor-number-color: #6bc26b;
    --jp-mirror-editor-def-color: #6cacf5;
    --jp-mirror-editor-variable-color: #c8c0b4;
    --jp-mirror-editor-variable-2-color: #7cb8d8;
    --jp-mirror-editor-variable-3-color: #6bc2a0;
    --jp-mirror-editor-punctuation-color: #7cb8d8;
    --jp-mirror-editor-property-color: #7cb8d8;
    --jp-mirror-editor-operator-color: #c8a0f0;
    --jp-mirror-editor-comment-color: #7a9a8a;
    --jp-mirror-editor-string-color: #e88070;
    --jp-mirror-editor-string-2-color: #d89cc0;
    --jp-mirror-editor-meta-color: #c8a0f0;
    --jp-mirror-editor-qualifier-color: #9a9288;
    --jp-mirror-editor-builtin-color: #72b866;
    --jp-mirror-editor-bracket-color: #b0a880;
    --jp-mirror-editor-tag-color: #72b866;
    --jp-mirror-editor-attribute-color: #6cacf5;
    --jp-mirror-editor-header-color: #6cacf5;
    --jp-mirror-editor-error-color: #ff6b6b;
  }

  /* Background */
  body {
    background-color: var(--ap-bg) !important;
  }

  /* Notebook body area */
  .jp-Notebook,
  .jp-NotebookPanel,
  div#notebook-container {
    background-color: var(--ap-bg) !important;
  }

  /* Cell containers */
  .jp-Cell,
  .jp-MarkdownCell,
  .jp-CodeCell {
    background-color: transparent !important;
  }

  /* Input areas — transparent so they blend with the page background;
     code cells still get a subtle tint via .highlight / editor background */
  .jp-InputArea,
  .jp-Editor,
  .jp-InputArea-editor,
  div.input_area {
    background-color: transparent !important;
    border-color: transparent !important;
  }

  /* Output area */
  .jp-OutputArea,
  .jp-OutputArea-child,
  div.output_area {
    background-color: var(--ap-bg) !important;
  }

  /* Headings — use system font stack similar to Mona Sans */
  .jp-RenderedHTMLCommon h1,
  .jp-RenderedHTMLCommon h2,
  .jp-RenderedHTMLCommon h3,
  .jp-RenderedHTMLCommon h4,
  .jp-RenderedHTMLCommon h5,
  .jp-RenderedHTMLCommon h6,
  .jp-RenderedMarkdown h1,
  .jp-RenderedMarkdown h2,
  .jp-RenderedMarkdown h3,
  .jp-RenderedMarkdown h4,
  .jp-RenderedMarkdown h5,
  .jp-RenderedMarkdown h6,
  #notebook-container h1,
  #notebook-container h2,
  #notebook-container h3,
  #notebook-container h4,
  #notebook-container h5,
  #notebook-container h6 {
    font-family: 'Mona Sans', 'Mona Sans Expanded', -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Helvetica, Arial, sans-serif !important;
    font-weight: 600 !important;
    color: var(--ap-text-heading) !important;
    letter-spacing: -0.01em;
  }

  /* Body text in markdown cells */
  .jp-RenderedHTMLCommon,
  .jp-RenderedMarkdown,
  .jp-RenderedMarkdown p,
  #notebook-container p {
    font-family: 'Mona Sans', -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Helvetica, Arial, sans-serif !important;
    color: var(--ap-text) !important;
  }

  /* Code font — keep monospace but soften the background */
  .jp-RenderedHTMLCommon code,
  .jp-RenderedMarkdown code {
    background-color: var(--ap-bg-muted) !important;
    border: 1px solid var(--ap-border) !important;
    border-radius: 3px;
    padding: 1px 4px;
  }

  /* Markdown fenced code blocks (e.g. the ASCII pipeline diagram) render as a
     bare .highlight whose background falls back to the default white editor
     colour in light mode, clashing with the warm page. Blend them into the
     page background. Python input cells live under .cm-editor and keep their
     own styling. */
  .jp-RenderedMarkdown .highlight,
  .jp-RenderedMarkdown .highlight pre,
  .jp-MarkdownOutput .highlight,
  .jp-MarkdownOutput .highlight pre {
    background: var(--ap-bg) !important;
  }

  /* Tables */
  .jp-RenderedHTMLCommon table,
  .dataframe {
    border-collapse: collapse !important;
  }

  .jp-RenderedHTMLCommon table th,
  .jp-RenderedHTMLCommon table td,
  .dataframe th,
  .dataframe td {
    border: 1px solid var(--ap-border) !important;
    padding: 6px 10px !important;
    color: var(--ap-text) !important;
  }

  .jp-RenderedHTMLCommon table th,
  .dataframe th {
    background-color: var(--ap-bg-muted) !important;
    font-weight: 600 !important;
  }

  .jp-RenderedHTMLCommon table tr:nth-child(even),
  .dataframe tbody tr:nth-child(even) {
    background-color: var(--ap-bg-alt) !important;
  }

  /* Left padding to align notebook header with site chrome */
  .jp-Notebook {
    padding-left: 2rem !important;
    padding-right: 1rem !important;
  }

  /* Scrollbar: hidden until user hovers/scrolls */
  html {
    scrollbar-gutter: stable;
  }
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 3px;
    transition: background 0.2s;
  }
  html:hover ::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
  }

  /* Firefox: thin auto-hidden scrollbar */
  html {
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }
  html:hover {
    scrollbar-color: var(--scrollbar-thumb) transparent;
  }

  /* Dark mode: invert matplotlib/image outputs for readability */
  html.dark .jp-OutputArea-output img,
  html.dark .jp-OutputArea-output svg {
    filter: invert(0.88) hue-rotate(180deg);
  }

  /* Hide toolbar / menu bar in embedded view */
  .jp-Toolbar,
  #menubar-container,
  .jp-NotebookPanel-toolbar {
    display: none !important;
  }

  /* ── Collapsible source cells (metadata.jupyter.source_hidden) ─── */
  details.ap-collapsible-code {
    margin: 0.25rem 0 0.5rem;
  }
  .ap-collapsible-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    width: fit-content;
    cursor: pointer;
    user-select: none;
    list-style: none; /* Firefox + standard: drop the default ▸ marker */
    padding: 3px 12px;
    border-radius: 999px;
    font-family: 'Mona Sans', -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ap-text);
    background: var(--ap-bg-muted);
    border: 1px solid var(--ap-border);
    /* Indent past the collapser + "In [N]:" prompt gutters so the pill lines up
       with the cell content column (headings, body text, code all start here). */
    margin-left: calc(
      var(--jp-cell-collapser-width) + var(--jp-cell-prompt-width) + 2 *
        var(--jp-code-padding)
    );
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .ap-collapsible-summary::-webkit-details-marker {
    display: none; /* old WebKit/Safari */
  }
  /* Caret drawn from borders so we don't depend on a glyph font */
  .ap-collapsible-summary::before {
    content: '';
    width: 0.5em;
    height: 0.5em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg); /* ▸ pointing right when closed */
    transition: transform 0.15s ease;
    opacity: 0.7;
  }
  details.ap-collapsible-code[open] > .ap-collapsible-summary::before {
    transform: rotate(45deg); /* ▾ pointing down when open */
  }
  .ap-collapsible-summary:hover {
    background: var(--ap-bg-alt);
    border-color: var(--ap-text);
    color: var(--ap-text-heading);
  }
  details.ap-collapsible-code[open] > .ap-collapsible-summary {
    margin-bottom: 0.25rem;
  }
  html.dark .ap-collapsible-summary:hover {
    border-color: #5a9fd4;
    color: var(--ap-text-heading);
  }
</style>
<script>
  (function() {
    // Apply dark mode from URL param: ?theme=dark
    var params = new URLSearchParams(window.location.search);
    if (params.get('theme') === 'dark') {
      document.documentElement.classList.add('dark');
    }

    // Report content height to parent for auto-resize (avoids double scrolling)
    function reportHeight() {
      var h = document.documentElement.scrollHeight;
      var path = window.location.pathname;
      var filename = (path.split('/').pop() || '').replace('.html', '');
      var mode = window.location.href.includes('playground-wasm') ? 'interactive' : 'static';
      if (window.parent !== window) {
        window.parent.postMessage({ type: 'notebook-height', height: h, id: mode + ':' + filename }, '*');
      }
    }
    if (document.readyState === 'complete') {
      reportHeight();
    } else {
      window.addEventListener('load', reportHeight);
    }
    new ResizeObserver(reportHeight).observe(document.documentElement);
  })();
</script>
{%- endblock header -%}

{#- Collapse code cells the author flagged with metadata.jupyter.source_hidden
    into a native <details> so long "helper" sections start collapsed but stay
    expandable. Only the input is wrapped — output_group is a sibling block, so
    any cell outputs remain visible. -#}
{%- block input_group -%}
{%- if cell.metadata.get('jupyter', {}).get('source_hidden', false) -%}
{%- set _src = cell.source if cell.source is string else cell.source | join('') -%}
<details class="ap-collapsible-code">
<summary class="ap-collapsible-summary">Show helper code · {{ _src.split('\n') | length }} lines</summary>
{{ super() }}
</details>
{%- else -%}
{{ super() }}
{%- endif -%}
{%- endblock input_group -%}
